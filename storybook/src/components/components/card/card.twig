{# Component: Card #}
{% set element = element|default('article') %}
{% set attributes = create_attribute(attributes|default({})) %}
{% set classes = [
  'card',
  'card--' ~ variant,
  link ? 'has-link' : ''
] %}
{% set attributes = attributes.addClass(classes) %}
{% set title_text = title|render %}

<{{ element }} {{ attributes.addClass(['card']) }}>
  {% if link %}
  <a href="{{ link }}" aria-label="{{ "Read:"|t ~ " " ~ title_text }}" class="card__overlay-link"></a>
  {% endif %}
  {% if image %}
    <div class="card__image">
      {{ image }}
    </div>
  {% endif %}
  <div class="card__content-wrapper">

    {% if link %}
      <h2 class="card__title h4"><a href="{{ link }}">{{ title_text }}</a></h2>
    {% else %}
      <h2 class="card__title h4">{{ title_text }}</h2>
    {% endif %}

    {% if tags %}
      <div class="card__tags">
        {% for tag in tags %}
          {% include 'aardvarck:pill' with {
            label: tag.label,
            href: tag.url|default('')
          } only %}
        {% endfor %}
      </div>
    {% endif %}

    <div class="card__content">{{ content }}</div>
  </div>
</{{ element }}>
