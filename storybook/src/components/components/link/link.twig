{# Component: Link #}

{% set base_class = 'c-link' %}
{% set attributes = create_attribute(attributes|default({})) %}
{% set classes = [
  base_class
] %}

<a href="{{ url }}" {{ attributes.addClass(classes) }}>
  {% if icon_id %}
    {% include 'aardvarck:icon' with {
      id: icon_id,
      size: 'small'
    } only %}
  {% endif %}
  {{ title }}
</a>
