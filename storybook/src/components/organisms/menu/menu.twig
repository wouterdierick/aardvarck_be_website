{# Component: Menu (Organism) #}
{% set attributes = create_attribute(attributes|default({})) %}
{% set classes = ['menu'] %}
{% set attributes = attributes.addClass(classes) %}

<nav {{ attributes }} aria-label="{{ name|default('Menu') }}">
  <ul class="menu__list">
    {% for link in links %}
      <li class="menu__item {% if link.active %}menu__item--active{% endif %}">
        {% include 'aardvarck:link' with {
          title: link.title,
          url: link.href,
          attributes: {
            class: 'menu__link'
          }
        } only %}
      </li>
    {% endfor %}
  </ul>
</nav>
