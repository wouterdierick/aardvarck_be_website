{# Component: Button (Atom) #}
{% set element = element|default('button') %}
{% set button_type = type|default('button') %}
{% set href = href|default('#') %}
{% set attributes = create_attribute(attributes|default({})) %}
{% set classes = ['button', 'button--' ~ variant] %}
{% set attributes = attributes.addClass(classes) %}

{% if aria_label is defined and aria_label is not empty %}
  {% set attributes = attributes.setAttribute('aria-label', aria_label) %}
{% endif %}

{% if disabled %}
  {% if element == 'a' %}
    {% set attributes = attributes.setAttribute('aria-disabled', 'true') %}
    {% set attributes = attributes.setAttribute('tabindex', '-1') %}
  {% else %}
    {% set attributes = attributes.setAttribute('disabled', 'disabled') %}
  {% endif %}
{% endif %}

{% if element == 'input' %}
  <input type="{{ button_type }}" value="{{ title }}" {{ attributes }}>
{% elseif element == 'a' %}
  <a {% if not disabled %}href="{{ href }}"{% endif %} {{ attributes }}>{{ title }}</a>
{% else %}
  <button type="{{ button_type }}" {{ attributes }}>{{ title }}</button>
{% endif %}
