{# Component: Button #}

{% set base_class = 'c-button' %}
{% set element = element|default('button') %}
{% set button_type = type|default('button') %}
{% set href = href|default('#') %}
{% set icon_id = icon_id|default('') %}
{% set color = color|default('default') %}
{% set size = size|default('default') %}
{% set layout = layout|default('icon-label') %}
{% set attributes = create_attribute(attributes|default({})) %}
{% set classes = [
    base_class,
    base_class ~ '--' ~ color,
    base_class ~ '--' ~ size,
    base_class ~ '--' ~ layout,
  ]
%}
{% set attributes = attributes.addClass(classes) %}

{% if aria_label is defined and aria_label is not empty %}
  {% set attributes = attributes.setAttribute('aria-label', aria_label) %}
{% endif %}

{% if disabled %}
  {% if element == 'a' %}
    {% set attributes = attributes.setAttribute('aria-disabled', 'true') %}
    {% set attributes = attributes.setAttribute('tabindex', '-1') %}
  {% else %}
    {% set attributes = attributes.setAttribute('disabled', 'disabled') %}
  {% endif %}
{% endif %}

{% if element == 'input' %}
  <input type="{{ button_type }}" value="{{ title }}" {{ attributes }}>
{% elseif element == 'a' %}
  <a {% if not disabled %}href="{{ href }}"{% endif %} {{ attributes }}>
    {% if icon_id %}
      {% include 'aardvarck:icon' with {
        id: icon_id,
        size: 'medium'
      } only %}
    {% endif %}
    <span class="{{ base_class }}__label">{{ title }}</span>
  </a>
{% else %}
  <button type="{{ button_type }}" {{ attributes }}>
    {% if icon_id %}
      {% include 'aardvarck:icon' with {
        id: icon_id,
        size: 'small'
      } only %}
    {% endif %}
    <span class="{{ base_class }}__label">{{ title }}</span>
  </button>
{% endif %}


