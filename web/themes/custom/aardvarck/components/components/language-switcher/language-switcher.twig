{# Component: Language switcher #}
{% set base_class = 'c-language-switcher' %}
{% set attributes = create_attribute(attributes|default({})) %}
{% set classes = [
  base_class,
  base_class ~ '--' ~ variant|default('link-list')
] %}
{% set attributes = attributes.addClass(classes) %}

{% set active_title = title|default('Select language') %}
{% for link in links %}
  {% if link.active %}
    {% set active_title = link.title %}
  {% endif %}
{% endfor %}

{% set list_id = 'language-switcher-list' ~ '-' ~ random() %}

<nav {{ attributes }} aria-label="{{ name|default('Select language') }}">

  {% if variant == 'link-list' %}
    {% include 'aardvarck:icon' with {
      id: 'message',
      size: 'small',
    } only %}
  {% endif %}

  {% if variant == 'dropdown' %}
    {% include 'aardvarck:button' with {
      attributes: {
        'class': base_class ~ '__toggle',
        'aria-expanded': 'false',
        'aria-controls': list_id,
      },
      title: active_title,
      aria_label: active_title,
      element: 'button',
      type: 'button',
      color: 'secondary',
      layout: 'icon-label',
      href: '#',
      icon_id: 'message',
    } only %}
  {% endif %}

  {% if variant == 'dropdown' %}
  <ul class="{{ base_class }}__list" aria-hidden="true" hidden>
  {% else %}
  <ul class="{{ base_class }}__list" id="{{ list_id }}">
  {% endif %}
    {% for link in links %}
      <li class="{{ base_class }}__item {% if link.active %}{{ base_class }}__item--active{% endif %}">
        {% include 'aardvarck:link' with {
          title: link.title,
          url: link.href,
          attributes: {
            class: base_class ~ '__link'
          }
        } only %}
      </li>
    {% endfor %}
  </ul>
</nav>
