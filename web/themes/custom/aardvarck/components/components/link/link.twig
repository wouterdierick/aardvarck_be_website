{# Component: Link #}

{% set base_class = 'c-link' %}
{% set attributes = create_attribute(attributes|default({})) %}
{% set hide_label = hide_label|default(false) %}
{% set classes = [
  base_class
] %}

<a href="{{ url }}" {{ attributes.addClass(classes) }}>
  {% if icon_id %}
    {% include 'aardvarck:icon' with {
      id: icon_id,
      size: 'small'
    } only %}
  {% endif %}
  {% if hide_label and icon_id %}
    <span class="visually-hidden">{{ title }}</span>
  {% else %}
    {{ title }}
  {% endif %}
</a>
