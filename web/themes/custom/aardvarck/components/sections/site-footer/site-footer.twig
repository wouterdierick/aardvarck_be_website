{# Component: Site footer #}
{% set base_class = 'c-site-footer' %}
{% set attributes = create_attribute(attributes|default({})) %}
{% set classes = [
  base_class,
] %}
{% set attributes = attributes.addClass(classes) %}

<footer {{ attributes }}>
  <div class="container">
    <div class="{{ base_class }}__wrapper">


      <div>



      {% include 'aardvarck:logo-horizontal' with {
        size: 'small',
      } only %}

        <p>Wouter Dierick</p>
        <p>+32 485 682 342</p>
        <p><a href="mailto:hello@aardvarck.be">hello@aardvarck.be</a></p>
      </div>

      {{ footernavigation }}
    </div>
  </div>
</footer>
