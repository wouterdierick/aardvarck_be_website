{# Component: Site header #}
{% set base_class = 'c-site-header' %}
{% set attributes = create_attribute(attributes|default({})) %}
{% set drawer_id = attributes.id|default(base_class ~ '-drawer-' ~ random()) %}
{% set desktop_mainnavigation = desktop_mainnavigation|default(null) %}
{% set mobile_mainnavigation = mobile_mainnavigation|default(null) %}
{% set desktop_languageswitcher = desktop_languageswitcher|default(null) %}
{% set mobile_languageswitcher = mobile_languageswitcher|default(null) %}
{% set desktop_usermenu = desktop_usermenu|default(null) %}
{% set mobile_usermenu = mobile_usermenu|default(null) %}
{% set show_cart = show_cart|default(false) %}
{% set cart_count = cart_count|default(0) %}
{% set cart_url = cart_url|default('/cart') %}
{% set cart_label = cart_label|default('Shopping cart') %}
{% set login_url = login_url|default('/user/login') %}
{% set login_label = login_label|default('Login') %}
{% set is_logged_in = is_logged_in|default(false) %}
{% set classes = [
  base_class,
] %}
{% set attributes = attributes.addClass(classes) %}

<div {{ attributes }}>
  <div class="container">
    <div class="{{ base_class }}__bar">
      <div class="{{ base_class }}__branding">
        {% include 'aardvarck:logo' with branding only %}
      </div>
      <div class="{{ base_class }}__desktop-navigation">
        {% include 'aardvarck:menu' with desktop_mainnavigation only %}
      </div>
      <div class="{{ base_class }}__utilities">
        <div class="{{ base_class }}__desktop-utilities">
          {% if desktop_languageswitcher %}
            <div class="{{ base_class }}__utility {{ base_class }}__utility--language">
              {% include 'aardvarck:language-switcher' with desktop_languageswitcher only %}
            </div>
          {% endif %}
          {% if show_cart %}
            <div class="badge-wrapper">
              {% include 'aardvarck:button' with {
                attributes: {
                  'class': base_class ~ '__utility-link' ~ ' ' ~ base_class ~ '__utility-link--cart',
                },
                title: '{{ cart_label }}',
                aria_label: '{{ cart_label }}',
                element: 'a',
                color: 'ghost',
                layout: 'icon-only',
                href: cart_url,
                icon_id: 'cart',
              } only %}
              {% if cart_count %}
                <span class="{{ base_class }}__cart-badge">{{ cart_count }}</span>
              {% endif %}
            </div>
          {% endif %}
          <div class="{{ base_class }}__utility {{ base_class }}__utility--account">
            {% if is_logged_in and desktop_usermenu %}
              {% include 'aardvarck:user-menu' with desktop_usermenu only %}
            {% else %}
              {% include 'aardvarck:button' with {
                element: 'a',
                title: login_label,
                href: login_url,
                icon_id: 'user',
                color: 'ghost',
                layout: 'icon-only',
                attributes: {
                  class: base_class ~ '__utility-link'
                }
              } only %}
            {% endif %}
          </div>
        </div>
        <div class="{{ base_class }}__mobile-utilities">
          {% include 'aardvarck:button' with {
            attributes: {
              'class': base_class ~ '__menu-toggle',
              'aria-expanded': 'false',
              'aria-controls': drawer_id,
            },
            title: 'Open navigation',
            aria_label: 'Open navigation',
            element: 'button',
            type: 'button',
            color: 'ghost',
            layout: 'icon-only',
            href: '#',
            icon_id: 'menu',
          } only %}
          {% include 'aardvarck:button' with {
            attributes: {
              'class': base_class ~ '__menu-close',
              'hidden': 'hidden',
            },
            title: 'Close navigation',
            aria_label: 'Close navigation',
            element: 'button',
            type: 'button',
            color: 'ghost',
            layout: 'icon-only',
            href: '#',
            icon_id: 'close',
          } only %}
          {% if show_cart %}
            <div class="badge-wrapper">
              {% include 'aardvarck:button' with {
                attributes: {
                  'class': base_class ~ '__utility-link' ~ ' ' ~ base_class ~ '__utility-link--cart',
                },
                title: '{{ cart_label }}',
                aria_label: '{{ cart_label }}',
                element: 'a',
                color: 'ghost',
                layout: 'icon-only',
                href: cart_url,
                icon_id: 'cart',
              } only %}
              {% if cart_count %}
                <span class="{{ base_class }}__cart-badge">{{ cart_count }}</span>
              {% endif %}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
    <div
      id="{{ drawer_id }}"
      class="{{ base_class }}__drawer"
      aria-hidden="true"
      hidden
    >
      <div class="{{ base_class }}__drawer-inner">
        <div class="{{ base_class }}__mobile-navigation">
          {% include 'aardvarck:menu' with mobile_mainnavigation only %}
        </div>
        <div class="{{ base_class }}__mobile-secondary">
          {% if mobile_languageswitcher %}
            {% include 'aardvarck:language-switcher' with mobile_languageswitcher only %}
          {% endif %}
          {% if is_logged_in and mobile_usermenu %}
            {% include 'aardvarck:user-menu' with mobile_usermenu only %}
          {% else %}
            {% include 'aardvarck:link' with {
              title: login_label,
              url: login_url,
              icon_id: 'user',
              attributes: {
                class: base_class ~ '__drawer-login-link'
              }
            } only %}
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>
